MONGODB_URI=
MONGODB_DB_NAME=po_select_league
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical URL for Open Graph / link previews (set on Vercel to https://www.poselectleague.com)
NEXT_PUBLIC_SITE_URL=https://www.poselectleague.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# --- SMTP (registration + contact form emails) ---
# Required: SMTP_HOST, SMTP_FROM, SMTP_USER, SMTP_PASS (except local Mailpit)
# Gmail: use smtp.gmail.com, port 587, SMTP_SECURE=false, and an App Password (not your normal password).
# SendGrid: host smtp.sendgrid.net, user apikey, pass = your API key.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Address shown in the "From" field (use the same mailbox as SMTP_USER for Gmail)
SMTP_FROM=
SMTP_FROM_NAME=P-O Select League
# Optional reply-to (defaults to SMTP_USER)
SMTP_REPLY_TO=

# Fallback inbox when Admin → Settings notification emails are empty
ADMIN_EMAIL=

ADMIN_PASSWORD=
# Set ADMIN_RESET=true (or npm run create-admin:reset) to update an existing admin password
ADMIN_RESET=
